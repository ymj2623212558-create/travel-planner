# ===== 旅行规划后端配置模板 =====
# 复制此文件为 .env 并填写你的配置：cp .env.example .env

# API Key（任何 OpenAI 兼容接口的 Key）
# 支持：DeepSeek / Dogrouter / OpenAI / 通义千问 / 硅基流动 / Moonshot 等
API_KEY=你的API密钥

# API 基础地址（须与 Key 同一服务商）
# Dogrouter 示例：https://api.dogrouter.ai/v1
# DeepSeek 示例：https://api.deepseek.com/v1
# OpenAI 示例：https://api.openai.com/v1
API_BASE=https://api.dogrouter.ai/v1

# 主模型（DeepSeek 或 Qwen 系列）
API_MODEL=deepseek-v4-flash

# 免费次数限制开关（false = 不限次数；true = 每人免费 8 次后需填自己的 Key）
ENABLE_QUOTA=false
